                "imageInfos" : "",
                "richTextValue" : "<div class=\"knowledge-section\" id=\"knowledge\"><h2 class=\"knowledge-section__title\">Knowledge Articles</h2><p class=\"knowledge-section__subtitle\">Find answers to common questions and explore detailed guides.</p><div class=\"knowledge-grid\"><div class=\"knowledge-column\"><div class=\"knowledge-column__header\">Partnering with Pronto</div><ul class=\"knowledge-column__list\"><li class=\"knowledge-column__list-item\"><a href=\"#\">How does Pronto work?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">Is Pronto available in my area?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">How do I activate my restaurant?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">How long does it take to get started?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">Merchant FAQs</a></li></ul><div class=\"knowledge-column__footer\"><a href=\"#\">View all 20+</a></div></div><div class=\"knowledge-column\"><div class=\"knowledge-column__header\">Updating Menu Information</div><ul class=\"knowledge-column__list\"><li class=\"knowledge-column__list-item\"><a href=\"#\">How do I update my menu?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">How do I mark an item out of stock?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">How do I edit item prices?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">Optimizing your menu</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">Editing modifiers</a></li></ul><div class=\"knowledge-column__footer\"><a href=\"#\">View all 19</a></div></div><div class=\"knowledge-column\"><div class=\"knowledge-column__header\">Tablet &amp; Hardware Support</div><ul class=\"knowledge-column__list\"><li class=\"knowledge-column__list-item\"><a href=\"#\">How do I troubleshoot my tablet?</a></li><li class=\"knowledge-column__list-item\"><a href=\"#\">How do scheduled orders work?</a></li><li class=\"knowledge-colu