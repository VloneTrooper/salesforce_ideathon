                "imageInfos" : "",
                "richTextValue" : "<div class=\"stats-strip\"><div><strong>98%</strong><span>Resolved same day</span></div><div><strong>24/7</strong><span>Merchant line</span></div><div><strong>&lt;5 min</strong><span>Avg. response</span></div></div><div class=\"quick-links\"><h2 class=\"quick-links__title\">Quick actions</h2><p class=\"quick-links__subtitle\">Jump straight to the tools you use most.</p><div class=\"quick-links__grid\"><div class=\"quick-links__card\"><div class=\"quick-links__image\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/orders.svg\" alt=\"\"></div><div class=\"quick-links__header\">Go to Orders</div><div class=\"quick-links__body\">View and manage incoming orders</div><div class=\"quick-links__footer\"><a href=\"/orders\">Open orders</a></div></div><div class=\"quick-links__card\"><div class=\"quick-links__image\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/menu.svg\" alt=\"\"></div><div class=\"quick-links__header\">Manage Menu</div><div class=\"quick-links__body\">Update items, prices and availability</div><div class=\"quick-links__footer\"><a href=\"/menu\">Manage menu</a></div></div><div class=\"quick-links__card\"><div class=\"quick-links__image\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/insights.svg\" alt=\"\"></div><div class=\"quick-links__header\">View Insights</div><div class=\"quick-links__body\">Track sales and performance</div><div class=\"quick-links__footer\"><a href=\"/insights\">View insights</a></div></div></div></div>"
