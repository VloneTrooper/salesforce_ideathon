                "imageInfos" : "",
                "richTextValue" : "<div class=\"hero hero--merchant\"><div class=\"hero__layout\"><div class=\"hero__content\"><p class=\"hero__eyebrow\">Merchant Support</p><h1 class=\"hero__headline\">Run your restaurant, the easy way</h1><p class=\"hero__subheadline\">Manage orders, update your menu and get the answers you need to keep your kitchen running smoothly.</p><div class=\"hero__quick\"><span class=\"hero__quick-label\">Popular</span><a class=\"hero__pill\" href=\"/orders\">Orders</a><a class=\"hero__pill\" href=\"/menu\">Menu</a><a class=\"hero__pill\" href=\"#support\">Hardware</a><a class=\"hero__pill\" href=\"#knowledge\">Payouts</a></div><div class=\"hero__chips\"><span class=\"hero__chip\">Same-day resolution</span><span class=\"hero__chip\">Dedicated merchant line</span><span class=\"hero__chip\">Free hardware support</span></div><div class=\"hero__cta\"><a class=\"hero__button hero__button--primary\" href=\"/dashboard\">Go to Dashboard</a><a class=\"hero__button hero__button--secondary\" href=\"#support\">Contact support</a></div></div><div class=\"hero__photo\"><img src=\"/sfsites/c/resource/pronto_support_redesign/merchant-hero.jpg\" alt=\"Restaurant dining room\"><div class=\"hero__badge\">98% of issues resolved same day</div></div></div></div>"
