                        "richTextValue": "<div class=\"stats-strip\"><div><strong>2 min</strong><span>Avg. first reply</span></div><div><strong>24/7</strong><span>Live support</span></div><div><strong>4.9★</strong><span>Support rating</span></div></div><div class=\"customer-card-section\"><h2 class=\"customer-card-section__title\">How can we help you today?</h2><p class=\"customer-card-section__subtitle\">Select a category to explore resources and solutions.</p><div class=\"customer-cards\"><div class=\"customer-card\"><div class=\"customer-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/track.svg\" alt=\"\"></div><h3 class=\"customer-card__title\">Track Your Order</h3></div><div class=\"customer-card\"><div class=\"customer-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/refund.svg\" alt=\"\"></div><h3 class=\"customer-card__title\">Refund Requests</h3></div><div class=\"customer-card\"><div class=\"customer-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/chat.svg\" alt=\"\"></div><h3 class=\"customer-card__title\">24/7 Support</h3></div><div class=\"customer-card\"><div class=\"customer-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/alert.svg\" alt=\"\"></div><h3 class=\"customer-card__title\">Delivery Issues</h3></div><div class=\"customer-card\"><div class=\"customer-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/account.svg\" alt=\"\"></div><h3 class=\"customer-card__title\">Account Settings</h3></div></div></div>"
