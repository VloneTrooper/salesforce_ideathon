                        "imageInfos": "",
                        "richTextValue": "<div class=\"support-section\" id=\"support\"><h2 class=\"support-section__title\">Need assistance?</h2><p class=\"support-section__subtitle\">We're here to help. Choose the support option that works best for you.</p><div class=\"support-grid\"><div class=\"support-card\"><div class=\"support-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/customer-chat.svg\" alt=\"\"></div><div class=\"support-card__header\">Live Chat</div><div class=\"support-card__body\">Chat with our team for real-time help with orders and account questions.</div><div class=\"support-card__footer\"><a href=\"#\">Start chat</a></div></div><div class=\"support-card\"><div class=\"support-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/customer-phone.svg\" alt=\"\"></div><div class=\"support-card__header\">Phone Support</div><div class=\"support-card__body\">Talk to a support specialist about any complex issue or inquiry.</div><div class=\"support-card__footer\"><a href=\"#\">Call us</a></div></div><div class=\"support-card\"><div class=\"support-card__icon\"><img src=\"/sfsites/c/resource/pronto_support_redesign/icons/customer-mail.svg\" alt=\"\"></div><div class=\"support-card__header\">Email Support</div><div class=\"support-card__body\">Send us your questions and we'll reply as soon as possible.</div><div class=\"support-card__footer\"><a href=\"#\">Email us</a></div></div></div></div>"
