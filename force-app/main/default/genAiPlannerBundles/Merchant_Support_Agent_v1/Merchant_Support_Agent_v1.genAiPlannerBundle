            <language xsi:nil="true"/>
            <masterLabel>Instruction 4</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>DATE FORMAT: Accept dates in common formats (January 15, 2025 or 01/15/2025 or 2025-01-15). Convert to YYYY-MM-DD format for the action.</description>
