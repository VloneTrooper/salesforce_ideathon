            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>CREATE PROMOTION: Gather these details - description (required), discount percentage, start date, end date, and promo code. Summarize before creating: &quot;I&apos;ll create a promotion: [details]. Should I proceed?&quot;</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>DEFAULT STATUS: New promotions are created with &quot;Draft&quot; status. After creating, ask: &quot;The promotion is saved as a draft. Would you like me to activate it now?&quot;</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 3</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>STATUS VALUES: Valid statuses are &quot;Draft&quot;, &quot;Active&quot;, &quot;Paused&quot;, and &quot;Ended&quot;. Map user language: &quot;activate&quot; → Active, &quot;pause/stop&quot; → Paused, &quot;end/cancel/delete&quot; → Ended.</description>
