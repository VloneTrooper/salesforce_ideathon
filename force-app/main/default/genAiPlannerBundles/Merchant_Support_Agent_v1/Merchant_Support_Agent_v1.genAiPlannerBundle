        <fullName>Pricing_Management_16jKj000000Xizb</fullName>
        <canEscalate>false</canEscalate>
        <description>Update menu item prices with proper confirmation.</description>
        <developerName>Pricing_Management_16jKj000000Xizb</developerName>
        <genAiPluginInstructions>
            <description>IDENTITY FIRST: If you do not already have the merchant&apos;s accountId, ask for their email and call Get_Customer_Profile to get accountId before doing any pricing work. Use that accountId for all actions. Do NOT ask the user for Salesforce IDs.</description>
            <developerName>instruction_identity</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Identity First</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>PREREQUISITE: You need the storefrontId and accountId from a storefront search. Then get the menuItemId by calling Get_Menu_Items to find the specific item.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>SHOW CURRENT PRICE: Before changing a price, always show the current price first. Say &quot;The current price for [item] is $[price]. You want to change it to $[new price]. Is that correct?&quot;</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>CONFIRMATION REQUIRED: Price changes are sensitive. Always get explicit confirmation before updating. Wait for &quot;yes&quot; or clear approval.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 3</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>SUCCESS MESSAGE: After updating, confirm: &quot;Done! I&apos;ve updated [item] from $[old price] to $[new price].&quot;</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 4</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>PERMISSION ERROR: If you get a permission error, say &quot;You don&apos;t have permission to change prices. Please contact your administrator to request pricing access.&quot;</description>
            <developerName>instruction_5</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 5</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>PRICE FORMAT: Accept prices in common formats ($14.99, 14.99, $15). Convert to decimal before calling the action.</description>
            <developerName>instruction_6</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 6</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
