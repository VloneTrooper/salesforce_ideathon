subagent pricing_management:
    label: "Pricing Management"
    description: "Update menu item prices after showing the current price and getting explicit confirmation."

    reasoning:
        instructions: ->
            | You need storefrontId and accountId from a storefront search, then menuItemId from Get_Menu_Items.
              Before changing a price, always show the current price first: "The current price for [item] is $[price]. You want to change it to $[new price]. Is that correct?"
              Price changes are sensitive. Wait for explicit confirmation before calling Update_Menu_Item_Price.
              Accept prices in common formats and convert to a decimal number before calling the action.
              If the update returns a permission error, say the merchant does not have permission to change prices and should contact an administrator.
              After receiving the update result, include the message value in your response and do not call the action again.
        actions:
            Get_Menu_Items: @actions.Get_Menu_Items
                with accountId = ...
                with menuId = ...
                with storefrontId = ...
            Update_Menu_Item_Price: @actions.Update_Menu_Item_Price
                with accountId = ...
                with menuItemId = ...
                with price = ...

    actions:
        Get_Menu_Items:
            description: "Retrieves menu items so the current price can be shown before a price update."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                menuId: string
                    description: "The Menu__c record Id to retrieve items for. If provided, storefrontId is ignored."
                    label: "Menu Id"
                    is_required: False
                    is_user_input: False
                storefrontId: string
                    description: "The Storefront__c record Id to retrieve all menu items for."
                    label: "Storefront Id"
                    is_required: False
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                menuItems: list[object]
                    description: "List of menu items."
                    label: "Menu Items"
                    complex_data_type_name: "@apexClassType/c__AgentGetMenuItemsActions$MenuItemSummary"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentGetMenuItemsActions"
            label: "Get Menu Items"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "Get_Menu_Items"
        Update_Menu_Item_Price:
            description: "Updates the Price__c field on a menu item."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                menuItemId: string
                    description: "The Menu_Item__c record Id to update."
                    label: "Menu Item Id"
                    is_required: True
                    is_user_input: False
                price: number
                    description: "New price for the menu item as a decimal number."
                    label: "Price"
                    is_required: True
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentUpdateMenuItemPriceActions"
            label: "Update Menu Item Price"
            require_user_confirmation: True
            include_in_progress_indicator: False
            source: "Update_Menu_Item_Price"

subagent promotions_management:
    label: "Promotions Management"
    description: "Create promotions with discounts, date ranges, promo codes, and manage promotion status."

    reasoning:
        instructions: ->
            | You need storefrontId and accountId from a storefront search before creating or managing promotions.
              To create a promotion, gather description, discount percentage, start date, end date, and promo code when available.
              New promotions should default to Draft unless the user explicitly asks for another valid status.
              Valid statuses are Draft, Active, Paused, and Ended. Map user language like activate to Active, pause or stop to Paused, and end or cancel to Ended.
              Convert dates to YYYY-MM-DD and promo codes to uppercase without spaces.
              Before creating or changing a promotion, summarize the details and ask "Should I proceed?"
              After receiving action results, include the message and promotion summary values directly in your text response. Do NOT use the show_command tool.
        actions:
            Create_Promotion: @actions.Create_Promotion
                with accountId = ...
                with storefrontId = ...
                with "description" = ...
                with discountPercentage = ...
                with startDate = ...
                with endDate = ...
                with promotionCode = ...
                with status = ...
            Update_Promotion_Status: @actions.Update_Promotion_Status
                with accountId = ...
                with promotionId = ...
                with status = ...

    actions:
        Create_Promotion:
            description: "Creates a new promotion or offer for a storefront with specified details."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                storefrontId: string
                    description: "The Storefront__c record Id to associate the promotion with."
                    label: "Storefront Id"
                    is_required: True
                    is_user_input: False
                "description": string
                    description: "Description of the promotion."
                    label: "Description"
                    is_required: True
                    is_user_input: False
                discountPercentage: number
                    description: "Discount percentage, e.g., 10 for 10% off."
                    label: "Discount Percentage"
                    is_required: False
                    is_user_input: False
                startDate: string
                    description: "Promotion start date. Format: YYYY-MM-DD."
                    label: "Start Date"
                    is_required: False
                    is_user_input: False
                endDate: string
                    description: "Promotion end date. Format: YYYY-MM-DD."
                    label: "End Date"
                    is_required: False
                    is_user_input: False
                promotionCode: string
                    description: "Optional promo code customers can use."
                    label: "Promotion Code"
                    is_required: False
                    is_user_input: False
                status: string
                    description: "Initial status. Defaults to Draft if not provided."
                    label: "Status"
                    is_required: False
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                promotionId: string
                    description: "The Id of the created promotion."
                    label: "Promotion Id"
                    filter_from_agent: False
                    is_displayable: False
                success: boolean
                    description: "True when the promotion was created successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentCreatePromotionActions"
            label: "Create Promotion"
            require_user_confirmation: True
            include_in_progress_indicator: False
            source: "Create_Promotion"
        Update_Promotion_Status:
            description: "Updates the status of an existing promotion."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                promotionId: string
                    description: "The Promotion__c record Id to update."
                    label: "Promotion Id"
                    is_required: True
                    is_user_input: False
                status: string
                    description: "New status for the promotion. Common values: Draft, Active, Paused, Ended."
                    label: "Status"
                    is_required: True
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
