system:
    instructions: |
        You are the Merchant Support Agent for Pronto's restaurant and merchant partners.
        Help merchants identify their account, view and update contact details, manage storefront details and hours, view and update menus, update menu item prices, create and manage promotions, and summarize reviews.

        Never ask users for Salesforce record IDs. Use names, email addresses, linked messaging context, and prior action results to determine verifiedCustomerId, accountId, storefrontId, menuId, menuItemId, and promotionId.
        Before any protected contact-detail, storefront, menu, pricing, promotion, or review action, make sure you have the merchant's verifiedCustomerId or accountId as needed. If you do not, ask for the merchant's email and use Get_Customer_Profile.
        For write actions, summarize the intended change and wait for explicit merchant confirmation before calling the action. Contact-detail updates are the exception: after identity is verified and the requested field changes are known, call Update_Contact_Record directly so the action can enforce Contact permissions and return the exact outcome. Do not claim a write succeeded unless the action output confirms success.
        When presenting action results, use exact returned values. Do NOT use the show_command tool. Always compose your response as direct text.
    messages:
        welcome: "Hi, I'm your Merchant Support Agent. I can help with contact details, storefronts, menus, pricing, promotions, and reviews. Which storefront or merchant account are you working with today?"
        error: "Something went wrong processing that request. Please check the merchant, storefront, or menu details and try again, or ask to connect with a live agent."

config:
    developer_name: "Merchant_Support_Agent_AS"
    default_agent_user: "agentforce_service_agent@00dkj00000uxdmh1294317499.ext"
    agent_label: "Merchant Support Agent"
    agent_type: "AgentforceServiceAgent"
    description: "Helps Pronto merchant partners manage storefronts, menus, pricing, promotions, and reviews through messaging support."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    VerifiedCustomerId: mutable string = ""
        description: "A verified Contact Id when available from the messaging context."
    accountId: mutable string = ""
        description: "The merchant Account Id returned by customer or storefront lookup."
    storefrontId: mutable string = ""
        description: "The selected Storefront__c Id returned by storefront lookup."
    menuId: mutable string = ""
        description: "The selected Menu__c Id returned by menu lookup."
    menuItemId: mutable string = ""
        description: "The selected Menu_Item__c Id returned by menu item lookup."
    promotionId: mutable string = ""
        description: "The selected Promotion__c Id for promotion status updates."
    VoiceCallId: linked string
        description: "This variable may also be referred to as Voice Call Id"
        source: @VoiceCall.Id

knowledge:
    citations_enabled: False

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent subagent_selector:
    label: "Subagent Selector"
    description: "Routes merchant support requests to identity, contact details, storefront, menu, pricing, promotion, review, escalation, or guardrail subagents."

    reasoning:
        instructions: ->
            | Select the best subagent for the user's intent.
              Use customer_identification when the user provides an email, asks to verify their merchant account, or needs accountId before a protected operation.
              Use view_and_update_contact_details when the user wants to view or change their contact email, phone number, or mailing address.
              Use storefront_management for storefront search, description, phone, status, overview, and hours.
              Use menu_management for viewing active menus, listing menu items, and updating non-price item fields such as description, availability, calories, or image URL.
              Use pricing_management for menu item price changes.
              Use promotions_management for creating promotions or changing promotion status.
              Use reviews_management for review summaries, ratings, trends, and recommendations.
              Use escalation only when the user asks for a live agent or the issue cannot be resolved by these merchant tools.
        actions:
            go_to_customer_identification: @utils.transition to @subagent.customer_identification
            go_to_view_and_update_contact_details: @utils.transition to @subagent.view_and_update_contact_details
            go_to_storefront_management: @utils.transition to @subagent.storefront_management
            go_to_menu_management: @utils.transition to @subagent.menu_management
            go_to_pricing_management: @utils.transition to @subagent.pricing_management
            go_to_promotions_management: @utils.transition to @subagent.promotions_management
            go_to_reviews_management: @utils.transition to @subagent.reviews_management
            go_to_escalation: @utils.transition to @subagent.escalation
            go_to_off_topic: @utils.transition to @subagent.off_topic
            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question

subagent customer_identification:
    label: "Customer Identification"
    description: "Verify merchant identity by email and retrieve accountId for protected merchant support actions."

    reasoning:
        instructions: ->
            | If you do not know the merchant's accountId and the user asks to show, search, or update storefronts, menus, prices, promotions, or reviews, ask for the merchant's email and use Get_Customer_Profile.
              If the user asks to view or update contact details, route to View and Update Contact Details instead of handling the change here.
              If the user already searched for a storefront and the result includes accountId, use that accountId instead of asking for email again.
              Never ask the user for Salesforce IDs.
              After Get_Customer_Profile succeeds, greet the merchant by firstName and say you found their account.
              If no customer is found, say: "I couldn't find an account with that email. Please check the email address and try again."
        actions:
            Get_Customer_Profile: @actions.Get_Customer_Profile
                with verifiedCustomerId = @variables.VerifiedCustomerId
                with customerEmail = ...
                set @variables.accountId = @outputs.accountId
                set @variables.VerifiedCustomerId = @outputs.customer.id

    actions:
        Get_Customer_Profile:
            description: "Get a customer's profile by email or Id. Returns customer details including their Account Id for use with other actions."
            inputs:
                verifiedCustomerId: string
                    description: "The Contact Id for the verified customer whose details should be returned."
                    label: "Verified Customer Id"
                    is_required: False
                    is_user_input: False
                customerEmail: string
                    description: "The customer email address. Provide this when you don't have the record Id."
                    label: "Customer Email"
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True when the action executed successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
                found: boolean
                    description: "True when a customer record was found."
                    label: "Found"
                    filter_from_agent: False
                    is_displayable: False
                message: string
                    description: "User-readable status message. On errors, explains what failed."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                accountId: string
                    description: "The Account Id associated with this customer."
                    label: "Account Id"
                    filter_from_agent: False
                    is_displayable: False
                firstName: string
                    description: "Customer first name."
                    label: "First Name"
                    filter_from_agent: False
                    is_displayable: True
                lastName: string
                    description: "Customer last name."
                    label: "Last Name"
                    filter_from_agent: False
                    is_displayable: True
                customer: object
                    description: "Full customer details object."
                    label: "Customer"
                    complex_data_type_name: "@apexClassType/c__AgentCustomerActions$CustomerDetails"
                    filter_from_agent: False
                    is_displayable: True
                customerJson: string
                    description: "JSON-serialized version of customer details."
                    label: "Customer JSON"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentCustomerActions"
            label: "Get Customer Profile"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Looking up the merchant account..."
            source: "Get_Customer_Profile"

subagent view_and_update_contact_details:
    label: "View and Update Contact Details"
    description: "View or update the merchant's Contact email address, phone number, and mailing address after identity is verified."

    reasoning:
        instructions: ->
            | Handle requests to view or update the merchant's contact details, including email address, phone number, and mailing address.
              Identity first: if you do not have @variables.VerifiedCustomerId, ask for the merchant's email and call Get_Customer_Profile. Reuse the returned verifiedCustomerId for the rest of the conversation.
              If @variables.VerifiedCustomerId is already known, do not ask for email again before updating contact details.
              For view requests, call Get_Customer_Profile and show the current email and phone number from the customer output. If mailing address is not returned by the profile lookup, say you can still update the mailing address if they provide the new values.
              For update requests, collect only the fields the user wants to change: email, phone, mailing street, city, state, postal code, and country.
              After identity is verified and at least one new contact field is known, call Update_Contact_Record with verifiedCustomerId and only the new values. Leave unchanged fields blank.
              Do not ask for a separate confirmation before Update_Contact_Record. The action enforces Contact permissions and returns the message to show the user.
              After the update action returns, include its message exactly. Do not claim the contact was updated unless success is True.
              If Get_Customer_Profile returns found=False, ask the merchant to double-check their email. If they still cannot be found, offer live-agent escalation.
        actions:
            Get_Customer_Profile: @actions.Get_Customer_Profile
                with verifiedCustomerId = @variables.VerifiedCustomerId
                with customerEmail = ...
                set @variables.accountId = @outputs.accountId
                set @variables.VerifiedCustomerId = @outputs.customer.id
            Update_Contact_Record: @actions.Update_Contact_Record
                with verifiedCustomerId = @variables.VerifiedCustomerId
                with email = ...
                with phone = ...
                with mailingStreet = ...
                with mailingCity = ...
                with mailingState = ...
                with mailingPostalCode = ...
                with mailingCountry = ...
            go_to_escalation: @utils.transition to @subagent.escalation

    actions:
        Get_Customer_Profile:
            description: "Get a verified customer profile by email or Contact Id before viewing or updating contact details."
            inputs:
                verifiedCustomerId: string
                    description: "The Contact Id for the verified customer whose details should be returned."
                    label: "Verified Customer Id"
                    is_required: False
                    is_user_input: False
                customerEmail: string
                    description: "The customer email address. Provide this when you don't have the record Id."
                    label: "Customer Email"
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True when the action executed successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
                found: boolean
                    description: "True when a customer record was found."
                    label: "Found"
                    filter_from_agent: False
                    is_displayable: False
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                accountId: string
                    description: "The Account Id associated with this customer."
                    label: "Account Id"
                    filter_from_agent: False
                    is_displayable: False
                firstName: string
                    description: "Customer first name."
                    label: "First Name"
                    filter_from_agent: False
                    is_displayable: True
                lastName: string
                    description: "Customer last name."
                    label: "Last Name"
                    filter_from_agent: False
                    is_displayable: True
                customer: object
                    description: "Full customer details object, including email and phone when available."
                    label: "Customer"
                    complex_data_type_name: "@apexClassType/c__AgentCustomerActions$CustomerDetails"
                    filter_from_agent: False
                    is_displayable: True
                customerJson: string
                    description: "JSON-serialized version of customer details."
                    label: "Customer JSON"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentCustomerActions"
            label: "Get Customer Profile"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Looking up contact details..."
            source: "Get_Customer_Profile"
        Update_Contact_Record:
            description: "Update a verified Contact record with provided email, phone, and mailing address fields. Blank fields are ignored."
            inputs:
                verifiedCustomerId: string
                    description: "The Contact Id for the verified customer whose profile and mailing address should be updated."
                    label: "Verified Customer Id"
                    is_required: True
                    is_user_input: False
                email: string
                    description: "Updated email address for the contact. Leave blank if the email address should not be changed."
                    label: "Email"
                    is_required: False
                    is_user_input: True
                phone: string
                    description: "Updated phone number for the contact. Leave blank if the phone number should not be changed."
                    label: "Phone"
                    is_required: False
                    is_user_input: True
                mailingStreet: string
                    description: "New mailing street value. Leave blank if the street should not be changed."
                    label: "Mailing Street"
                    is_required: False
                    is_user_input: True
                mailingCity: string
                    description: "New mailing city value. Leave blank if the city should not be changed."
                    label: "Mailing City"
                    is_required: False
                    is_user_input: True
                mailingState: string
                    description: "New mailing state or province value. Leave blank if the state should not be changed."
                    label: "Mailing State"
                    is_required: False
                    is_user_input: True
                mailingPostalCode: string
                    description: "New mailing postal or ZIP code value. Leave blank if the postal code should not be changed."
                    label: "Mailing Postal Code"
                    is_required: False
                    is_user_input: True
                mailingCountry: string
                    description: "New mailing country value. Leave blank if the country should not be changed."
                    label: "Mailing Country"
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True when the action executed successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
                message: string
                    description: "User-readable status message. On errors, explains what was missing or what failed."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                returnedContact: object
                    description: "The updated Contact record with refreshed field values, limited by sharing and FLS."
                    label: "Returned Contact"
                    complex_data_type_name: "lightning__recordInfoType"
                    filter_from_agent: False
                    is_displayable: True
            target: "apex://AgentUpdateContactRecordActions"
            label: "Update Contact Record"
            require_user_confirmation: False
            include_in_progress_indicator: False

subagent storefront_management:
    label: "Storefront Management"
    description: "Search storefronts and update storefront details or hours. Always look up storefront IDs and account IDs instead of asking users for Salesforce IDs."

    reasoning:
        instructions: ->
            | Before updating a storefront, use Get_Storefronts_By_Name or Get_Storefronts_By_Account to get storefrontId and accountId.
              Use BOTH storefrontId and accountId when calling Update_Storefront_Details or Update_Storefront_Hours.
              You can update description, phone number, status, overview, and one day's hours at a time.
              Before making any update, summarize what will change and ask "Should I proceed with this update?" Wait for confirmation.
              If an update returns access denied, tell the user they do not have permission to modify that storefront and do not retry.
              After receiving storefront results, write storefront names, descriptions, cuisine, and review scores directly in your text response. Do NOT use the show_command tool.
        actions:
            Get_Storefronts_By_Name: @actions.Get_Storefronts_By_Name
                with storefrontName = ...
            Get_Storefronts_By_Account: @actions.Get_Storefronts_By_Account
                with accountId = ...
            Update_Storefront_Details: @actions.Update_Storefront_Details
                with accountId = ...
                with storefrontId = ...
                with "description" = ...
                with phone = ...
                with status = ...
                with overview = ...
            Update_Storefront_Hours: @actions.Update_Storefront_Hours
                with accountId = ...
                with storefrontId = ...
                with dayOfWeek = ...
                with openingTime = ...
                with closingTime = ...
                with notes = ...

    actions:
        Get_Storefronts_By_Name:
            description: "Query Storefront__c by name and return matching storefronts with id and accountId."
            inputs:
                storefrontName: string
                    description: "The storefront name or partial name to search for."
                    label: "Storefront Name"
                    is_required: True
                    is_user_input: True
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                storefronts: list[object]
                    description: "List of matching storefronts with id and accountId."
                    label: "Storefronts"
                    complex_data_type_name: "@apexClassType/c__AgentStorefrontActions$StorefrontSummary"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentStorefrontActions"
            label: "Get Storefronts By Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "Get_Storefronts_By_Name"
        Get_Storefronts_By_Account:
            description: "Lists storefronts for a given Account Id."
            inputs:
                accountId: object
                    description: "The Account Id that owns the storefronts."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordIdType"
            outputs:
                success: boolean
                    description: "True when the action executed successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                storefronts: list[object]
                    description: "List of storefronts for the account."
                    label: "Storefronts"
                    complex_data_type_name: "@apexClassType/c__AgentGetStorefrontsByAccountActions$StorefrontSummary"
                    filter_from_agent: False
                    is_displayable: True
            target: "apex://AgentGetStorefrontsByAccountActions"
            label: "Get Storefronts By Account"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "Get_Storefronts_By_Account"
        Update_Storefront_Details:
            description: "Updates non-sensitive storefront fields such as description, phone, status, and overview."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                storefrontId: string
                    description: "The Storefront__c record Id to update."
                    label: "Storefront Id"
                    is_required: True
                    is_user_input: False
                "description": string
                    description: "New description for the storefront. Leave blank to skip."
                    label: "Description"
                    is_required: False
                    is_user_input: False
                phone: string
                    description: "New phone number for the storefront. Leave blank to skip."
                    label: "Phone"
                    is_required: False
                    is_user_input: False
                status: string
                    description: "New status for the storefront. Leave blank to skip."
                    label: "Status"
                    is_required: False
                    is_user_input: False
                overview: string
                    description: "New overview text for the storefront. Leave blank to skip."
                    label: "Overview"
                    is_required: False
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentUpdateStorefrontDetailsActions"
            label: "Update Storefront Details"
            require_user_confirmation: True
            include_in_progress_indicator: False
            source: "Update_Storefront_Details"
        Update_Storefront_Hours:
            description: "Updates or creates operating hours for a storefront on a specific day of the week."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                storefrontId: string
                    description: "The Storefront__c record Id whose hours should be updated."
                    label: "Storefront Id"
                    is_required: True
                    is_user_input: False
                dayOfWeek: string
                    description: "The day to update."
                    label: "Day of Week"
                    is_required: True
                    is_user_input: False
                openingTime: string
                    description: "Opening time in HH:MM format."
                    label: "Opening Time"
                    is_required: False
                    is_user_input: False
                closingTime: string
                    description: "Closing time in HH:MM format."
                    label: "Closing Time"
                    is_required: False
                    is_user_input: False
                notes: string
                    description: "Optional notes for this day."
                    label: "Notes"
                    is_required: False
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentUpdateStorefrontHoursActions"
            label: "Update Storefront Hours"
            require_user_confirmation: True
            include_in_progress_indicator: False
            source: "Update_Storefront_Hours"

subagent menu_management:
    label: "Menu Management"
    description: "View and update menus and menu items except pricing. Price changes are handled by Pricing Management."

    reasoning:
        instructions: ->
            | You need storefrontId and accountId before viewing menus or items. If missing, ask for storefront name or merchant email and use the appropriate lookup subagent or action.
              Use Get_Active_Menus to show active menus for a storefront. Display menu names and descriptions, then ask which menu the merchant wants to explore.
              Use Get_Menu_Items to list item name, description, price, calories, and availability. Use menuId when the merchant selected a menu; use storefrontId to list all items for a storefront.
              Use Update_Menu_Item only for description, availability, calories, and image URL. Do not use it for price changes.
              If the merchant asks to change a price, say price changes are handled separately and route to Pricing Management.
              When a merchant says an item is sold out or 86'd, set available to False after confirming the item.
              After receiving menu or item results, write the menuCount, menu names, item names, descriptions, prices, calories, and availability values directly in your text response. Do NOT use the show_command tool.
        actions:
            Get_Active_Menus: @actions.Get_Active_Menus
                with accountId = ...
                with storefrontId = ...
            Get_Menu_Items: @actions.Get_Menu_Items
                with accountId = ...
                with menuId = ...
                with storefrontId = ...
            Update_Menu_Item: @actions.Update_Menu_Item
                with accountId = ...
                with menuItemId = ...
                with "description" = ...
                with available = ...
                with calories = ...
                with imageUrl = ...
            go_to_pricing_management: @utils.transition to @subagent.pricing_management

    actions:
        Get_Active_Menus:
            description: "Retrieves all active menus for a given storefront. Requires accountId for security."
            inputs:
                accountId: object
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordIdType"
                storefrontId: object
                    description: "The Storefront__c record Id to retrieve menus for."
                    label: "Storefront Id"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordIdType"
            outputs:
                menuCount: integer
                    description: "Number of active menus found."
                    label: "Menu Count"
                    filter_from_agent: False
                    is_displayable: False
                menus: list[object]
                    description: "A list of active menus for the storefront."
                    label: "Menus"
                    complex_data_type_name: "@apexClassType/c__AgentGetActiveMenusActions$MenuSummary"
                    filter_from_agent: False
                    is_displayable: True
                menusJson: string
                    description: "JSON-serialized version of menus."
                    label: "Menus JSON"
                    filter_from_agent: False
                    is_displayable: False
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True when the query executed successfully."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentGetActiveMenusActions"
            label: "Get Active Menus"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "Get_Active_Menus"
        Get_Menu_Items:
            description: "Retrieves menu items for a selected menu or all items for a storefront."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                menuId: string
                    description: "The Menu__c record Id to retrieve items for. If provided, storefrontId is ignored."
                    label: "Menu Id"
                    is_required: False
                    is_user_input: False
                storefrontId: string
                    description: "The Storefront__c record Id to retrieve all menu items for."
                    label: "Storefront Id"
                    is_required: False
                    is_user_input: False
            outputs:
                message: string
                    description: "User-readable status message."
                    label: "Message"
                    filter_from_agent: False
                    is_displayable: True
                menuItems: list[object]
                    description: "List of menu items."
                    label: "Menu Items"
                    complex_data_type_name: "@apexClassType/c__AgentGetMenuItemsActions$MenuItemSummary"
                    filter_from_agent: False
                    is_displayable: True
                success: boolean
                    description: "True if successful."
                    label: "Success"
                    filter_from_agent: False
                    is_displayable: False
            target: "apex://AgentGetMenuItemsActions"
            label: "Get Menu Items"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "Get_Menu_Items"
        Update_Menu_Item:
            description: "Updates descriptive menu item fields such as description, availability, calories, and image URL. Does NOT update price."
            inputs:
                accountId: string
                    description: "The Account Id that owns the storefront. Required for security validation."
                    label: "Account Id"
                    is_required: True
                    is_user_input: False
                menuItemId: string
                    description: "The Menu_Item__c record Id to update."
                    label: "Menu Item Id"
                    is_required: True
                    is_user_input: False
                "description": string
                    description: "New description for the menu item. Leave blank to skip."
                    label: "Description"
                    is_required: False
                    is_user_input: False
                available: boolean
