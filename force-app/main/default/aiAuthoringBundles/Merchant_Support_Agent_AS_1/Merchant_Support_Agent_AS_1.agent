                    is_user_input: False
                calories: number
                    description: "New calorie count. Leave null to skip."
                    label: "Calories"
                    is_required: False
                    is_user_input: False
                imageUrl: string
                    description: "New image URL for the menu item. Leave blank to skip."
                    label: "Image URL"
