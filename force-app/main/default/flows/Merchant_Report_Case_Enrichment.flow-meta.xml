<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Copy_Storefront</name>
        <label>Copy Storefront</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Storefront__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sender_Contact.Storefront__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Reported_Storefront</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Handoff_Issue</name>
        <label>Set Handoff Issue</label>
        <locationX>314</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Handoff Issue</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Merchant Operations</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Out_Of_Stock</name>
        <label>Set Out of Stock</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Out of Stock</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Merchant Operations</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Prep_Delay</name>
        <label>Set Prep Delay</label>
        <locationX>182</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Prep Delay</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Merchant Operations</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Use_Reported_Storefront</name>
        <label>Use Reported Storefront</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>$Record.Storefront__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Reported_Storefront.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Merchant_Ops_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Route_To_Merchant_Ops</name>
        <label>Route To Merchant Ops</label>
        <locationX>182</locationX>
        <locationY>380</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Merchant_Ops_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Classify_Issue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Contact_From_Email</name>
        <label>Set Contact From Email</label>
        <locationX>50</locationX>
        <locationY>90</locationY>
        <assignmentItems>
            <assignToReference>$Record.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Link_Contact.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Link_Contact.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Link_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Matches</name>
        <label>Count Matches</label>
        <locationX>50</locationX>
        <locationY>65</locationY>
        <assignmentItems>
            <assignToReference>countMatches</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Contacts_By_Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Exactly_One_Contact</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Contact</name>
        <label>Has Contact</label>
        <locationX>182</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Has_Reported_Storefront</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No contact</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sender_Contact</targetReference>
            </connector>
            <label>Contact found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Classify_Issue</name>
        <label>Classify Issue</label>
        <locationX>182</locationX>
        <locationY>400</locationY>
        <defaultConnector>
            <targetReference>Set_Handoff_Issue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Out_Of_Stock</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>subjectLower</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>out of</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>subjectLower</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>86</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Out_Of_Stock</targetReference>
            </connector>
            <label>Out of stock</label>
        </rules>
        <rules>
            <name>Prep_Delay</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>subjectLower</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>late</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>subjectLower</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>delay</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Prep_Delay</targetReference>
            </connector>
            <label>Prep delay</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Reported_Storefront</name>
        <label>Has Reported Storefront</label>
        <locationX>182</locationX>
        <locationY>320</locationY>
        <defaultConnector>
            <targetReference>Get_Merchant_Ops_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Reported_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reported_Storefront__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Reported_Storefront</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reported_Storefront_Found</name>
        <label>Reported Storefront Found</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Merchant_Ops_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Found_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Reported_Storefront.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Reported_Storefront</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Needs_Email_Match</name>
        <label>Needs Email Match</label>
        <locationX>182</locationX>
        <locationY>40</locationY>
        <defaultConnector>
            <targetReference>Has_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Match_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SuppliedEmail</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contacts_By_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Exactly_One_Contact</name>
        <label>Exactly One Contact</label>
        <locationX>50</locationX>
        <locationY>70</locationY>
        <defaultConnector>
            <targetReference>Has_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>One_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contactMatchCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Contact</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Phase 1. If no Contact is set but SuppliedEmail matches exactly one Contact, links that Contact and Account (used by the merchant site form). Also handles the Merchant Report web form: if Reported Storefront (text) matches a Storefront by name, it wins over the Contact storefront. Always routes to Merchant Ops Queue. When an email from a merchant or courier becomes a Case (Origin = Merchant Report), copy the sender Contact Storefront onto the Case, set Type = Merchant Operations, and classify Reason from subject keywords: out of / 86 = Out of Stock, late / delay = Prep Delay, anything else = Handoff Issue.</description>
    <environments>Default</environments>
    <formulas>
        <name>subjectLower</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.Subject})</expression>
    </formulas>
    <formulas>
        <name>contactMatchCount</name>
        <dataType>Number</dataType>
        <expression>{!countMatches}</expression>
        <scale>0</scale>
    </formulas>
    <label>Merchant Report Case Enrichment</label>
    <loops>
        <name>Link_Contact</name>
        <label>Link Contact</label>
        <locationX>50</locationX>
        <locationY>80</locationY>
        <collectionReference>Get_Contacts_By_Email</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Contact_From_Email</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Contact</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sender_Contact</name>
        <label>Get Sender Contact</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_Storefront</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Storefront__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Reported_Storefront</name>
        <label>Get Reported Storefront</label>
        <locationX>50</locationX>
        <locationY>340</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Reported_Storefront_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Reported_Storefront__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Storefront__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Merchant_Ops_Queue</name>
        <label>Get Merchant Ops Queue</label>
        <locationX>182</locationX>
        <locationY>370</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Route_To_Merchant_Ops</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Merchant_Ops_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contacts_By_Email</name>
        <label>Get Contacts By Email</label>
        <locationX>50</locationX>
        <locationY>60</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Matches</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SuppliedEmail</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>2</limit>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Needs_Email_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Merchant Report</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>countMatches</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
